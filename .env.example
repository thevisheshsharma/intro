# Copy this file to .env.local and replace every required placeholder.
# Never commit .env.local or real credentials.

# Privy authentication
NEXT_PUBLIC_PRIVY_APP_ID=replace-with-privy-development-app-id
PRIVY_APP_SECRET=replace-with-privy-development-app-secret

# Neo4j
NEO4J_URI=neo4j+s://replace-with-development-instance
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-development-password

# X/Twitter data provider
SOCIALAPI_BEARER_TOKEN=replace-with-development-token

# xAI/Grok
# Both names are currently referenced by the application and should be consolidated.
XAI_API_KEY=replace-with-development-key
GROK_API_KEY=replace-with-development-key

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_FOUNDER_MONTHLY_PRICE_ID=price_replace_me
STRIPE_FOUNDER_ANNUAL_PRICE_ID=price_replace_me
STRIPE_STANDARD_MONTHLY_PRICE_ID=price_replace_me
STRIPE_STANDARD_ANNUAL_PRICE_ID=price_replace_me

# Application URLs
# Both names are currently referenced and should be consolidated.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Protected operations
ADMIN_SECRET=replace-with-a-long-random-development-secret
CRON_SECRET=replace-with-a-different-long-random-development-secret
